<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ org_label | default('PaSE') }} Org Level Rollup — {{ rollup_date | format_date }}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #FFFFFF;
    color: #4B4B4B;
  }

  /* ── Header ── */
  .header {
    background: #111111;
    padding: 32px 48px 0;
  }
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .header h1 { color: #FFFFFF; font-size: 26px; font-weight: 700; letter-spacing: 0.5px; }
  .header .subtitle { color: #8B8B8B; font-size: 14px; margin-top: 4px; }
  .header .date-badge { color: #8B8B8B; font-size: 13px; text-align: right; white-space: nowrap; }
  .header .date-badge span { display: block; color: #CDDC39; font-size: 14px; font-weight: 700; }
  .volt-bar { height: 4px; background: #CDDC39; margin-top: 24px; }

  /* ── Pillars row ── */
  .pillars-row {
    padding: 14px 48px;
    border-bottom: 1px solid #D1D1D1;
    font-size: 12px;
    color: #8B8B8B;
  }
  .pillars-row strong { color: #111111; margin-right: 6px; }

  /* ── Headline ── */
  .headline {
    background: #F5F5F5;
    border-left: 4px solid #CDDC39;
    margin: 28px 48px 0;
    padding: 18px 22px;
  }
  .headline-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #111111;
    margin-bottom: 10px;
  }
  .headline p {
    font-size: 15px;
    color: #111111;
    line-height: 1.6;
    font-weight: 500;
  }

  /* ── Content sections ── */
  .content { padding: 24px 48px 40px; }
  .section { margin-bottom: 20px; }
  .section-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #111111;
    margin-bottom: 8px;
  }
  .alert {
    background: #FEF2F2;
    border-left: 4px solid #D22630;
    padding: 14px 18px;
    margin-bottom: 20px;
  }
  .alert .section-title { color: #991B1B; }
  .info {
    background: #EFF6FF;
    border-left: 4px solid #3B82F6;
    padding: 14px 18px;
    margin-bottom: 20px;
  }
  .info .section-title { color: #1D4ED8; }
  ul { list-style: none; padding: 0; }
  li { font-size: 13px; padding: 3px 0; line-height: 1.5; }
  li::before { content: "▸"; color: #CDDC39; font-weight: 700; margin-right: 8px; }
  .alert li::before { color: #D22630; }
  .info li::before { color: #3B82F6; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  /* ── Footer ── */
  .footer {
    background: #F5F5F5;
    padding: 14px 48px;
    border-top: 1px solid #D1D1D1;
    font-size: 12px;
    color: #8B8B8B;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .print-btn {
    display: inline-block;
    margin: 16px 48px;
    padding: 8px 20px;
    background: #111111;
    color: #CDDC39;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    border-radius: 2px;
  }
  @media print { .print-btn { display: none; } body { background: #fff; } }
</style>
</head>
<body>

{# ── Header ── #}
<div class="header">
  <div class="header-top">
    <div>
      <h1>Org Level Rollup</h1>
      <div class="subtitle">{{ org_label | default('PaSE') }} — VP Executive Briefing</div>
    </div>
    <div class="date-badge">
      Report date
      {% if rollup_date %}
      <span>{{ rollup_date | format_date }}</span>
      {% else %}
      <span>—</span>
      {% endif %}
    </div>
  </div>
  <div class="volt-bar"></div>
</div>

{# ── Pillars row ── #}
{% if pillars_included %}
<div class="pillars-row">
  <strong>Pillars:</strong>{{ pillars_included | join(', ') }}
</div>
{% endif %}

{# ── Headline ── #}
{% if headline %}
<div class="headline">
  <div class="headline-label">This week in {{ org_label | default('PaSE') }}</div>
  <p>{{ headline }}</p>
</div>
{% endif %}

{# ── Content ── #}
<div class="content">

  {% if top_priorities %}
  <div class="section">
    <div class="section-title">Top Priorities</div>
    <ul>{% for item in top_priorities %}<li>{{ item }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <div class="two-col">
    {% if critical_issues %}
    <div class="alert section">
      <div class="section-title">Critical Issues</div>
      <ul>{% for item in critical_issues %}<li>{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endif %}

    {% if decisions_needed %}
    <div class="info section">
      <div class="section-title">Decisions Needed</div>
      <ul>{% for item in decisions_needed %}<li>{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
  </div>

</div>

<button class="print-btn" onclick="window.print()">Save as PDF</button>

<div class="footer">
  <span>{{ footer_text }}</span>
  <span>Generated {{ generated_at }}</span>
</div>

</body>
</html>
