# Databricks workspace (required for production / FM API)
DATABRICKS_HOST=https://nike-sole-react.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-personal-access-token

# Foundation Model serving endpoint name (OpenAI-compatible)
# Examples: databricks-claude-sonnet-4-6, databricks-meta-llama-3-3-70b-instruct
DATABRICKS_MODEL_ENDPOINT=databricks-claude-sonnet-4-6

# Unity Catalog volume root for PaSE Work Tracker (create before deploy).
# Subfolders uploads/{pillar}/, summaries/{pillar}/, and registries/ are created
# automatically.
PASE_TRACKER_VOLUME=/Volumes/development/team_na_pase_process_intelligence/pase_work_tracker

# Local fallback when volume path is unavailable (dev on laptop)
PASE_TRACKER_LOCAL_DIR=./data/pase_work_tracker

# Optional: number of prior summaries to include as read-only context
CONTEXT_SUMMARY_COUNT=3

# Set to 1 to skip LLM calls and use rule-based extract (tests only)
MOCK_LLM=0

# Comma-separated list of admin/manager emails that may edit LLM prompts
# from the settings popover. Everyone else gets read-only access.
PASE_TRACKER_ADMIN_EMAILS=Spencer.Stendel@nike.com,Evan.Horne@nike.com

# Box shared link shown in the app header ("Ask questions..." chip), pointing
# at the Rally Box folder (Share > Copy Link in the Box UI). Defaults to the
# existing company-access shared link if unset.
PASE_TRACKER_BOX_FOLDER_LINK=https://nike.box.com/s/m7435ld1srodd92ck28qaid6j5nd7h6j
